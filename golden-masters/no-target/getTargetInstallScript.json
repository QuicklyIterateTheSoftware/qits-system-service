"#!/bin/sh\n# Installs (or replaces) qits-system-runner on this host: ONE docker container, supervised by docker's\n# own restart policy. For any Linux host with docker, run by root or by a user who may use docker.\n#\n# THIS SCRIPT IS RENDERED BY THE SERVER THE RUNNER REGISTERS WITH, from qits-runner-toolkit's\n# template (eu/wohlben/qits/runner/toolkit/install/runner-install.sh.tmpl, filled by\n# InstallScript.script). Every name in it is derived from the runner's RunnerIdentity, the same\n# value the runner derives its own names from, and only the image is a value the server pins. Its\n# `docker run` is the container contract a runner also rolls itself over into\n# (LifecycleArgv.runSuccessor): the toolkit's InstallScriptContractTest runs this script against a\n# stub docker and holds the two to one argv, element for element, so change them together.\n#\n# Not run by hand: the System UI's Targets page hands out ONE LINE that downloads this script and pipes it into `sudo env\n# QITS_SYSTEM_RUNNER_URL=... QITS_SYSTEM_RUNNER_ID=... QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN=... QITS_SYSTEM_RUNNER_SLOTS=... sh`.\n# So this script carries no secret and names no runner: the four values come from its environment,\n# and it runs in a shell of its own, so a refusal ends that shell and never the one it was pasted\n# into. Everything below is inside main(), called on the last line, so a download cut short runs\n# nothing at all.\n#\n# WHAT IT DOES:\n#\n#   1. refuses, one sentence each, when a value is missing or carries a character this script will\n#      not hand to docker, or when docker does not answer;\n#   2. logs in to the platform's registry with the registration token, in a throwaway docker config\n#      that is deleted right after, and pulls the runner image — the host's own docker config is\n#      never written;\n#   3. removes every container of this runner (label qits.system.runner.process=<id>) — a re-run\n#      REPLACES the runner, and a re-run with a new token is how a registration is rotated;\n#   4. keeps the runner's state volume but removes client.json from it, so the token it was just\n#      given is the one the runner registers with;\n#   5. starts the runner container, and prints how to watch it.\n#\n# The registration token appears in no line this script prints and in no command line: the login\n# reads it on stdin, and the container gets it as `-e QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN`, docker's\n# own \"take the value from my environment\" form.\nset -eu\n\nrefuse() {\n  echo \"qits-system-runner install: $*\" >&2\n  exit 1\n}\n\n# One sentence per missing value, naming it, and a charset that keeps every value one plain word: they\n# become container names, labels and environment values.\nrequire() { # $1 = name, $2 = value\n  [ -n \"$2\" ] || refuse \"$1 is not set; paste the whole line from the System UI's Targets page.\"\n  case \"$2\" in\n    *[!A-Za-z0-9._~+/=:-]*) refuse \"$1 carries a character this script will not hand to docker.\" ;;\n  esac\n}\n\nmain() {\n  require QITS_SYSTEM_RUNNER_URL \"${QITS_SYSTEM_RUNNER_URL:-}\"\n  require QITS_SYSTEM_RUNNER_ID \"${QITS_SYSTEM_RUNNER_ID:-}\"\n  require QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN \"${QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN:-}\"\n  require QITS_SYSTEM_RUNNER_SLOTS \"${QITS_SYSTEM_RUNNER_SLOTS:-}\"\n\n  # RENDERED: the image the server pins (the runner's image repository on its registry's public\n  # host) and its version, which is also the container name's suffix and the version label.\n  image='registry.qits.wohlben.eu/qits/qits-system-runner:frozen-token-1'\n  version=\"${image##*:}\"\n\n  registry=\"${image%%/*}\"\n  id8=$(printf '%s' \"$QITS_SYSTEM_RUNNER_ID\" | cut -c1-8)\n  name=\"qits-system-runner-$id8-$version\"\n  volume=\"qits-system-runner-state-$id8\"\n\n  command -v docker >/dev/null 2>&1 || refuse \"docker is not on PATH; install docker first.\"\n  docker version >/dev/null 2>&1 \\\n    || refuse \"docker does not answer (docker version failed); start it, or run this as root or as a user in the docker group.\"\n\n  # The registry answers an anonymous pull with 401, and the host's docker config is nobody's to\n  # write: a login there would outlive this script and serve every docker user on the host. So the\n  # login lives in a directory of its own (mktemp -d is 0700) and is gone before anything else runs.\n  config=$(mktemp -d)\n  if ! printf '%s' \"$QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN\" \\\n      | docker --config \"$config\" login \"$registry\" -u token --password-stdin >/dev/null 2>&1; then\n    rm -rf \"$config\"\n    refuse \"the registry $registry refused the registration token; paste a fresh line from the System UI's Targets page.\"\n  fi\n  if ! docker --config \"$config\" pull \"$image\" >/dev/null; then\n    rm -rf \"$config\"\n    refuse \"could not pull $image.\"\n  fi\n  rm -rf \"$config\"\n\n  # Whatever runs as this runner now goes: an earlier install, a runner that rolled itself over, an\n  # exited predecessor. The workload containers carry a different label and are the new runner's\n  # boot sweep's to remove.\n  for container in $(docker ps -aq --filter \"label=qits.system.runner.process=$QITS_SYSTEM_RUNNER_ID\"); do\n    docker rm -f \"$container\" >/dev/null\n  done\n\n  # The volume is KEPT — it is the runner's state — but its client goes: the runner registers with\n  # the token in this line, which on a re-run is a new one.\n  docker run --rm --entrypoint rm -v \"$volume:/var/lib/qits-system-runner\" \"$image\" \\\n    -f /var/lib/qits-system-runner/client.json\n\n  # `-e NAME` hands docker the value from its own environment, so the token is in no command line.\n  export QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN\n\n  # THE CONTAINER CONTRACT. docker's restart policy is the supervisor; the socket is how the runner\n  # starts its workloads and, when told to update, its own successor; the volume holds its client.\n  # No --network: docker's default bridge. The runner's own label is qits.system.runner.process — never\n  # qits.system.runner, which the runner's boot sweep removes. The three values go in the order\n  # LifecycleArgv.runSuccessor writes a successor's environment (sorted by name), the token last, so\n  # the two compare element for element.\n  set -- \\\n    -d \\\n    --name \"$name\" \\\n    --restart unless-stopped \\\n    --label \"qits.system.runner.process=$QITS_SYSTEM_RUNNER_ID\" \\\n    --label \"qits.system.runner.version=$version\" \\\n    -v /var/run/docker.sock:/var/run/docker.sock \\\n    -v \"$volume:/var/lib/qits-system-runner\" \\\n    -e \"QITS_SYSTEM_RUNNER_ID=$QITS_SYSTEM_RUNNER_ID\" \\\n    -e \"QITS_SYSTEM_RUNNER_SLOTS=$QITS_SYSTEM_RUNNER_SLOTS\" \\\n    -e \"QITS_SYSTEM_RUNNER_URL=$QITS_SYSTEM_RUNNER_URL\" \\\n    -e QITS_SYSTEM_RUNNER_REGISTRATION_TOKEN\n  # The operator's tuning, when the line (or the shell) set any. Everything else has its default.\n  for tuning in QITS_SYSTEM_RUNNER_DOCKER_TIMEOUT QITS_SYSTEM_RUNNER_PULL_TIMEOUT QITS_SYSTEM_RUNNER_ROLLOVER_TIMEOUT QITS_SYSTEM_RUNNER_CREDENTIAL_VOLUME QITS_SYSTEM_RUNNER_M2_VOLUME QITS_SYSTEM_RUNNER_PNPM_VOLUME; do\n    value=$(printenv \"$tuning\" || true)\n    if [ -n \"$value\" ]; then\n      case \"$value\" in\n        *[!A-Za-z0-9._~+/=:,-]*) refuse \"$tuning carries a character this script will not hand to docker.\" ;;\n      esac\n      set -- \"$@\" -e \"$tuning=$value\"\n    fi\n  done\n  docker run \"$@\" \"$image\" >/dev/null\n\n  echo \"qits-system-runner started; watch: docker logs -f $name\"\n}\n\nmain \"$@\"\n"
